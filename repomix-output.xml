            {/* APPOINTMENTS SCROLLING TABLE */}
            <div className="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex-1 flex flex-col min-h-[400px]">
                {loading && appointments.length === 0 ? (
